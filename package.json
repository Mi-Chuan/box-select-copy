{
  "name": "box-select-copy",
  "version": "1.1.1",
  "description": "Alt+drag box (rectangular) text selection and copy for the DSH conversation view.",
  "license": "MIT",
  "author": "Mi-Chuan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mi-Chuan/box-select-copy.git"
  },
  "homepage": "https://github.com/Mi-Chuan/box-select-copy#readme",
  "bugs": {
    "url": "https://github.com/Mi-Chuan/box-select-copy/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "box-selection",
    "clipboard"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
